---
// The raccoon easter egg. Tap it and it turns a somersault; drag it and it
// follows your finger, then slingshots home on a spring. The physics live in
// ../lib/raccoon.client.ts; this file is its other half — the markup, the
// resting pose, and the two classes the script toggles.
//
// It is decoration and nothing else: alt="", aria-hidden, and deliberately not
// in the tab order, so no content, layout, or link depends on it. Drop one on
// a page and the page is exactly itself plus a bit of fun.
//
// It carries NO position of its own. The caller wraps it in a positioned
// element of its own and tunes it with the custom properties below, because
// scoped styles don't cross a component boundary (see CLAUDE.md) but custom
// properties inherit:
//
//   --raccoon-w      rendered width       (default: clamp(100px, 26vw, 148px))
//   --raccoon-tilt   resting lean in deg  (default: -20deg)
//   --raccoon-turn   the somersault, as a signed angle: 360deg clockwise (the
//                    default), -360deg counter-clockwise
//
// The two placements in use are `.raccoon-hero` in src/pages/index.astro and
// `.raccoon-margin` in src/pages/[slug].astro.
import { Image } from "astro:assets";

interface Props {
  /** The imported photo. Any of src/assets/raccoon-*.webp. */
  image: ImageMetadata;
}

const { image } = Astro.props;
---

<Image
  src={image}
  alt=""
  class="raccoon"
  aria-hidden="true"
  draggable="false"
  widths={[148, 296]}
  sizes="148px"
  format="webp"
  layout="none"
  loading="eager"
  fetchpriority="high"
  decoding="async"
/>

<script>
  // Tap the raccoon and it somersaults; drag it and it slingshots home.
  import "../lib/raccoon.client.ts";
</script>

<style>
  /* The resting pose is written as the individual `translate` / `rotate`
     properties rather than one `transform`, so the two easter eggs can each
     move one part of it and leave the rest alone: the spin animates `rotate`,
     the drag writes the three --drag-* properties. */
  .raccoon {
    /* Set by the drag; 0 is home. The script removes them when it lands. */
    --drag-x: 0px;
    --drag-y: 0px;
    --drag-rot: 0deg;

    /* Positioned only so `is-dragging` has a z-index to lift it with. Its
       place on the page belongs to the wrapper the caller puts around it. */
    position: relative;
    display: block;
    width: var(--raccoon-w, clamp(100px, 26vw, 148px));
    height: auto;
    translate: var(--drag-x) var(--drag-y);
    rotate: calc(var(--raccoon-tilt, -20deg) + var(--drag-rot));
    user-select: none;
    opacity: 0.88;
    /* `grab` advertises the drag; the tap is the discovery on the way in.
       `touch-action: none` is what makes dragging work with a finger at all —
       without it the browser claims the gesture for scrolling. It costs a
       thumb-scroll that starts exactly on the raccoon, which is a ~148px patch
       of decoration; pointercancel still sends it home if the browser does
       take the gesture. */
    cursor: grab;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-drag: none;
  }

  /* In hand: above the page (and the hero headline, which sits at z-index 1),
     below the site header (50). No transition — it tracks the pointer 1:1, and
     any easing here would read as lag. */
  .raccoon.is-dragging {
    z-index: 10;
    cursor: grabbing;
    opacity: 1;
  }

  /* One full turn from the resting tilt, carrying whatever lean the drag left
     behind. Which way it turns is the caller's, via the sign of
     --raccoon-turn. The easing is the standard "back out" curve: it overshoots
     a few degrees past the landing and settles, which reads as a spring
     without a physics loop. ~0.6s is the sweet spot — long enough to see the
     raccoon, short enough to tap again. (The slingshot is a real spring; it
     has a whole gesture to justify the integrator, a tap doesn't.) */
  .raccoon.is-spinning {
    animation: raccoon-spin 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes raccoon-spin {
    from {
      rotate: calc(var(--raccoon-tilt, -20deg) + var(--drag-rot));
    }
    to {
      rotate: calc(var(--raccoon-tilt, -20deg) + var(--raccoon-turn, 360deg) + var(--drag-rot));
    }
  }

  /* Belt and braces: the script already refuses to spin here, but if the class
     ever lands some other way it must not animate. (The drag is exempt — it is
     direct manipulation, not animation, and it stops the moment you let go.) */
  @media (prefers-reduced-motion: reduce) {
    .raccoon.is-spinning {
      animation: none;
    }
  }
</style>
