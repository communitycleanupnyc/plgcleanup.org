---
// Readable, edge-aligned column for Markdown content pages (about, faq, terms,
// schedule, partners, and the rest). The rendered Markdown arrives via <slot/>,
// so its elements are styled with :global() below.
interface Props {
  /** Where the closing back-link points. Pass `null` to omit the link. */
  backHref?: string | null;
  backLabel?: string;
}

const { backHref = "/", backLabel = "← Back home" } = Astro.props;
---

<div class="prose">
  <slot />
  {
    /* set:html rather than a child expression: .prose-back is an underlined
      inline-block, so a stray whitespace text node either side of the label
      would render as underlined space. A self-closing tag can't collect any. */
  }
  <!-- {backHref && <a href={backHref} class="prose-back" set:html={backLabel} />} -->
</div>

<style>
  .prose {
    /* The content-page column (tokens.css). The override is local to this
       element and `margin-inline: auto` resolves against it, so the column
       re-centres at its narrower width on its own. */
    --site-w: var(--content-w);
    width: var(--site-w);
    margin-inline: auto;
    padding-top: var(--space-section);
    padding-bottom: var(--space-block);
  }

  .prose :global(h1) {
    margin-bottom: 1.25rem;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.75rem;
  }

  .prose :global(p) {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    line-height: 1.6;
  }

  .prose :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose-back {
    display: inline-block;
    margin-top: 1rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--text) 25%, transparent);
  }
  .prose-back:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }
  /* Focus ring comes from the global :focus-visible rule in base.css. */
</style>
