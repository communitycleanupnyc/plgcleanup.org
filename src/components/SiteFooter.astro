---
// Site footer. Every link comes from SITE.nav.footer, SITE.social, and
// SITE.footer — edit src/site.config.ts, not this file.
import { SITE } from "../site.config";
import NavLink from "./NavLink.astro";
import SplitFlap from "./SplitFlap.astro";
import Ticker from "./Ticker.astro";
import { POUNDS_COLLECTED, POUNDS_COLLECTED_DISPLAY } from "../data/stats";

// Build-time year. The daily rebuild (site-checks.yml `redeploy`) is what keeps
// this from going stale on 1 January without anyone pushing a commit.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    {
      SITE.nav.footer.map((column) => (
        <div class="footer-col">
          {column.map((link) => (
            <NavLink link={link} />
          ))}
        </div>
      ))
    }
    <div class="footer-col">
      {SITE.social.map((link) => <NavLink link={link} />)}
    </div>
    <div class="footer-right">
      {SITE.footer.legal.map((link) => <NavLink link={link} />)}
      <p class="footer-copyright">&copy; {year} {SITE.footer.copyright}</p>
      {
        SITE.footer.statLine && (
          <p class="footer-made">
            <SplitFlap
              value={POUNDS_COLLECTED}
              spoken={POUNDS_COLLECTED_DISPLAY}
              from={1000}
              label={SITE.footer.statLine}
            />
          </p>
        )
      }
    </div>
  </div>
  {SITE.features.ticker && <Ticker />}
</footer>
