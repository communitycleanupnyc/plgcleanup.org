---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import { headingKey } from "../plugins/collapsible-sections";

// One static route per Markdown file in src/content/pages/. The filename is the
// URL slug (faq.md → /faq). index.astro, join.astro, and schedule.astro are their
// own files — they render data, not just prose — and take precedence over this
// catch-all.
//
export async function getStaticPaths() {
  // Those hand-written routes win SILENTLY: a src/content/pages/join.md would
  // build clean and simply never appear, leaving an editor staring at the old
  // /join page wondering what they did wrong. Name the collision instead.
  // (Declared in here, not at module scope: Astro hoists getStaticPaths out of
  // the component, so it cannot see the frontmatter's other declarations.)
  const RESERVED_SLUGS = ["index", "join", "schedule", "404"];
  const pages = await getCollection("pages");
  for (const page of pages) {
    if (RESERVED_SLUGS.includes(page.id)) {
      throw new Error(
        `[pages] "${page.id}.md" can't be used: /${page.id} is already a built-in page of the site, ` +
          `so this file would never show up. Rename it to something else (the filename becomes the web address).`,
      );
    }
  }
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
// Guard the Markdown body (not covered by the frontmatter schema): a blank page
// would render just a title. Fail the build loudly instead.
if (!page.body?.trim()) {
  throw new Error(`[pages] "${page.id}.md" has an empty body. Add the page content.`);
}
const { Content, headings } = await render(page);

// `collapse:` names a heading to fold into a dropdown (see
// ../plugins/collapsible-sections.ts). A name that matches nothing would
// otherwise be invisible — the page builds clean and simply never collapses,
// which is what a renamed heading looks like. Checked against the headings
// Astro extracted from this very page, so the two can't drift.
const present = new Set(headings.map((h) => headingKey(h.text)));
for (const name of page.data.collapse) {
  if (!present.has(headingKey(name))) {
    throw new Error(
      `[pages] "${page.id}.md" asks to collapse the section "${name}", but has no heading with that text. ` +
        `Its headings are: ${headings.map((h) => `"${h.text}"`).join(", ") || "(none)"}. ` +
        `Capitalisation and spacing don't matter, but the words must match — renaming a heading means ` +
        `renaming it in the "collapse" list too.`,
    );
  }
}
---

<Base title={page.data.title} description={page.data.description} navMode={page.data.navMode}>
  <Prose>
    <Content />
  </Prose>
</Base>
