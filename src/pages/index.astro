---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import raccoon from "../assets/raccoon.webp";
import Carousel from "../components/Carousel.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Button from "../components/Button.astro";
import type { CarouselItem } from "../components/carousel.types";
import { render } from "astro:content";
import { VOLUNTEER_COUNT } from "../data/stats";
import { NEXT_CLEANUP } from "../data/schedule";
import { computeCountdown, renderCtaLabel } from "../data/countdown";
import { galleryOrder } from "../lib/gallery";

// Carousel items come from src/content/gallery/*.md (see src/content.config.ts).
// The image() schema validates every photo at build time, so a missing or
// misnamed image fails the build loudly — no hand-rolled checks needed.
// The running order — and so which photo leads the carousel and becomes the
// social share image — is decided in one place: src/lib/gallery.ts.
const entries = galleryOrder;

// The schema can't see the Markdown body, so guard it here: a blank body
// would render an empty reveal panel. Fail the build loudly instead.
for (const entry of entries) {
  if (!entry.body?.trim()) {
    throw new Error(`[gallery] "${entry.id}.md" has an empty body. Add the panel text.`);
  }
}

const items: CarouselItem[] = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      img: entry.data.image,
      alt: entry.data.alt,
      title: entry.data.title,
      caption: entry.data.caption,
      focusPosition: entry.data.focusPosition,
      Body: Content,
    };
  }),
);

// The CTA label carries the countdown ("Join us this Saturday"): it's baked in
// at build time here and recomputed on load by ../lib/countdown.client.ts
// (imported below) so it never goes stale between deploys.
const state = computeCountdown(new Date(), NEXT_CLEANUP.iso, NEXT_CLEANUP.endIso);
const ctaLabel = renderCtaLabel(state);
---

<Base
  title="Trash Cleanup in Prospect Lefferts Gardens"
  description="A volunteer trash cleanup crew in Prospect Lefferts Gardens, Brooklyn. No registration, all supplies provided — just show up."
>
  <Hero title="Clean Prospect Lefferts Gardens!">
    <Fragment slot="decoration">
      <Image
        src={raccoon}
        alt=""
        class="raccoon"
        aria-hidden="true"
        widths={[148, 296]}
        sizes="148px"
        format="webp"
        layout="none"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </Fragment>
    <p>
      {VOLUNTEER_COUNT} of your neighbors are helping keep trash off our streets.
    </p>
    <p>Want to see why people love volunteering with us?</p>
  </Hero>

  <div class="cta-actions">
    <Button
      href="/join"
      data-countdown
      data-variant="cta"
      data-start={NEXT_CLEANUP.iso}
      data-end={NEXT_CLEANUP.endIso}>{ctaLabel}</Button
    >
    <Button href="/schedule" variant="secondary">View schedule</Button>
  </div>

  <Section labelledby="why-label" bottom="block">
    <SectionHeading id="why-label" />
    <FeatureGrid columns={4}>
      <div>
        <h3>Why volunteer?</h3>
        <p>
          Every piece counts, down to a cigarette butt. Simply being visible inspires others to help
          our community. Bonus: volunteering has "<a
            href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10159229/"
            title="Cambridge University Press (2026)"
            >significant positive effects... on social, physical, and mental health.</a
          >"
        </p>
      </div>
      <div>
        <h3>What to expect</h3>
        <p>
          Just bring yourself! And water if it's hot out. We'll provide you with gloves, a grabber,
          and a bag. You'll find a stretch of sidewalk, and an hour later it's transformed. Optional
          crew photo at the end.
        </p>
      </div>
      <div>
        <h3>Who you'll meet</h3>
        <p>
          Around 5 to 10 fellow volunteers, including your clean leader(s). These are your neighbors
          and they rock.
        </p>
      </div>
      <div>
        <h3>Stay in touch</h3>
        <p>
          Sign up for our <a href="https://communitycleanupplg.substack.com/subscribe">newsletter</a
          >, follow us on <a href="https://www.instagram.com/communitycleanupplg">Instagram</a>,
          join us on <a href="https://discord.com/invite/H9her7r8N2">Discord</a>, or just send us an <a
            href="mailto:communitycleanupplg@gmail.com">email</a
          >!
        </p>
      </div>
    </FeatureGrid>
  </Section>

  <Carousel
    items={items}
    variant="natural"
    grayscale
    heading="Why trash club"
    labels={{
      open: "Read {title}'s testimonial",
      close: "Close {title}'s testimonial",
      region: "{title}'s testimonial",
    }}
  />
</Base>

<script>
  import "../lib/countdown.client.ts";
</script>

<style>
  /* Home page. The hero, section column, heading, and 3-col grid now live in
     components (Hero, Section, SectionHeading, FeatureGrid); what remains here
     is the decoration this page alone owns. */

  /* Positioned against Hero's headline block, which is position: relative. */
  .raccoon {
    position: absolute;
    z-index: 0;
    right: var(--edge);
    top: 110%;
    transform: translateY(-25%) rotate(-20deg);
    width: clamp(100px, 26vw, 148px);
    height: auto;
    pointer-events: none;
    user-select: none;
    opacity: 0.88;
  }

  @media (max-width: 380px) {
    .raccoon {
      width: 100px;
    }
  }
</style>
