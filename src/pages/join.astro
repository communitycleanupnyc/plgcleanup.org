---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import cart from "../assets/cart.webp";
import {
  CLEANUP_ISO,
  CLEANUP_END_ISO,
  CLEANUP_ISO_LOCAL,
  CLEANUP_END_ISO_LOCAL,
  CLEANUP_TIME,
  CLEANUP_CORNER,
  CLEANUP_MAPS_URL,
  CLEANUP_MAPS_EMBED_URL,
} from "../data/event";
import { computeCountdown, renderJoinCountdown } from "../data/countdown";
import { SITE } from "../site.config";

const cleanupDate = new Date(CLEANUP_ISO);
// Rendered at build time and recomputed on load by ../lib/countdown.client.ts.
const state = computeCountdown(new Date(), CLEANUP_ISO, CLEANUP_END_ISO);
const countdownLine = renderJoinCountdown(state);

const joinDisplayDate = new Intl.DateTimeFormat("en-US", {
  timeZone: "America/New_York",
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(cleanupDate);

// Event structured data — the one schema type with a visible SERP surface
// (Google event listings). Built from the same event.ts values shown on the page.
//
// Dropped entirely once the cleanup is over: there is no "next" event to flip to
// (event.json holds exactly one), and an EventScheduled node for a date that has
// already passed is worse in search results than no node at all. The daily
// rebuild in .github/workflows/site-checks.yml is what makes this take effect
// without anyone pushing a commit.
const isPastEvent = state.tag === "past";
const eventUrl = new URL("/join", Astro.site).href;
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `${SITE.name} — ${CLEANUP_CORNER}`,
  description:
    "A one-hour volunteer street cleanup in Prospect Lefferts Gardens, Brooklyn. No registration; all supplies provided. Just show up.",
  // Local time + offset, not UTC — the form Google's Event docs ask for.
  startDate: CLEANUP_ISO_LOCAL,
  endDate: CLEANUP_END_ISO_LOCAL,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  url: eventUrl,
  image: new URL(SITE.schema.logo, Astro.site).href,
  location: {
    "@type": "Place",
    name: CLEANUP_CORNER,
    address: {
      "@type": "PostalAddress",
      streetAddress: CLEANUP_CORNER,
      addressLocality: "Brooklyn",
      addressRegion: "NY",
      addressCountry: "US",
    },
  },
  organizer: {
    "@type": SITE.schema.type,
    name: SITE.name,
    url: new URL("/", Astro.site).href,
  },
};
---

<Base
  title="Volunteer"
  description="There's no registration — just show up. Here's where and when."
  navMode="static"
>
  <div class="join-page">
    <h1>Our next cleanup...</h1>
    {
      countdownLine && (
        <p
          class="join-countdown"
          data-countdown
          data-variant="join"
          data-start={CLEANUP_ISO}
          data-end={CLEANUP_END_ISO}
        >
          {countdownLine}
        </p>
      )
    }
    <p class="join-sub">
      Zero registration needed, and we provide the supplies—just show up. Look for the shopping cart
      with trash grabbers to find your squad leader and say hi.
    </p>

    <div class="join-details">
      <div class="join-detail">
        <p class="join-detail-label">When</p>
        <p class="join-detail-value">
          {joinDisplayDate}<br />{CLEANUP_TIME}
        </p>
      </div>
      <div class="join-cart-cell">
        <Image
          src={cart}
          alt=""
          class="join-cart"
          aria-hidden="true"
          widths={[240, 480]}
          sizes="240px"
          format="webp"
          layout="none"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="join-detail join-where">
        <p class="join-detail-label">Where</p>
        <p class="join-detail-value">
          <a href={CLEANUP_MAPS_URL} target="_blank" rel="noopener noreferrer">{CLEANUP_CORNER}</a
          ><br />
          Prospect Lefferts Gardens<br />Brooklyn, New York
        </p>
      </div>
      <div class="join-map-cell">
        <iframe
          src={CLEANUP_MAPS_EMBED_URL}
          class="join-map"
          title={`Map: ${CLEANUP_CORNER}, Brooklyn, NY`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <div class="join-detail join-questions">
        <p class="join-detail-label">Questions</p>
        <p class="join-detail-value">
          Can't find your team? Let us know you're waiting on <a
            href="https://discord.com/invite/H9her7r8N2">Discord</a
          > by sending a message in the #general channel. For all other inquiries, see the <a
            href="/faq">FAQ</a
          >.
        </p>
      </div>
    </div>
  </div>
  {
    !isPastEvent && (
      <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(eventSchema)}
      />
    )
  }
</Base>

<script>
  import "../lib/countdown.client.ts";
</script>

<style>
  /* /join page details grid. */
  .join-page {
    position: relative;
    width: var(--site-w);
    margin-left: var(--site-ml);
    padding-top: var(--space-section);
    padding-bottom: var(--space-block);
  }

  .join-cart-cell {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .join-cart {
    display: block;
    width: clamp(100px, 18vw, 240px);
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  .join-map {
    display: block;
    width: 100%;
    aspect-ratio: 1.618;
    border: 0;
    filter: invert(100%) hue-rotate(180deg);
  }

  .join-page h1 {
    margin-bottom: 1.25rem;
  }

  .join-countdown {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .join-sub {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text);
    margin-bottom: var(--space-gap);
  }

  .join-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: var(--space-gap);
  }

  @media (max-width: 540px) {
    .join-where {
      grid-column: 1 / -1;
    }
    .join-map-cell {
      grid-column: 1 / -1;
    }
    .join-questions {
      grid-column: 1 / -1;
    }
  }

  .join-detail-label {
    font-size: var(--fs-lg);
    font-weight: 400;
    letter-spacing: 0em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .join-detail-value {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    line-height: 1.45;
  }

  .join-reassurance {
    font-size: var(--fs-base);
    font-weight: 400;
    color: var(--text);
    opacity: 0.6;
  }

  .join-service-hours {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text);
  }
</style>
