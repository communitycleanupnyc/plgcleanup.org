---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import cart from "../assets/cart.webp";
import { NEXT_CLEANUP } from "../data/schedule";
import { computeCountdown, renderJoinCountdown } from "../data/countdown";
import { SITE } from "../site.config";

// The next cleanup still to come — src/data/schedule.ts picks it out of the
// schedule, so this page never names a date of its own.
const next = NEXT_CLEANUP;

// Rendered at build time and recomputed on load by ../lib/countdown.client.ts.
const state = computeCountdown(new Date(), next.iso, next.endIso);
const countdownLine = renderJoinCountdown(state);

// Event structured data — the one schema type with a visible SERP surface
// (Google event listings). Built from the same schedule.ts values shown on the page.
//
// Dropped once the cleanup is over, because an EventScheduled node for a date
// that has already passed is worse in search results than no node at all. That
// only happens when the schedule has run out of future dates — otherwise the
// daily rebuild in .github/workflows/site-checks.yml moves this page on to the
// next cleanup without anyone pushing a commit.
const isPastEvent = state.tag === "past";
const eventUrl = new URL("/join", Astro.site).href;
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `${SITE.name} — ${next.corner}`,
  description:
    "A one-hour volunteer street cleanup in Prospect Lefferts Gardens, Brooklyn. No registration; all supplies provided. Just show up.",
  // Local time + offset, not UTC — the form Google's Event docs ask for.
  startDate: next.isoLocal,
  endDate: next.endIsoLocal,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  url: eventUrl,
  image: new URL(SITE.schema.logo, Astro.site).href,
  location: {
    "@type": "Place",
    name: next.corner,
    address: {
      "@type": "PostalAddress",
      streetAddress: next.corner,
      addressLocality: "Brooklyn",
      addressRegion: "NY",
      addressCountry: "US",
    },
  },
  organizer: {
    "@type": SITE.schema.type,
    name: SITE.name,
    url: new URL("/", Astro.site).href,
  },
};
---

<Base
  title="Volunteer"
  description="There's no registration — just show up. Here's where and when."
  navMode="static"
>
  <div class="join-page">
    <h1>Our next cleanup...</h1>
    {
      countdownLine && (
        <p
          class="join-countdown"
          data-countdown
          data-variant="join"
          data-start={next.iso}
          data-end={next.endIso}
        >
          {countdownLine}
        </p>
      )
    }
    <p class="join-sub">
      Zero registration needed, and we provide the supplies—just show up. Look for the shopping cart
      with trash grabbers to find your squad leader and say hi.
    </p>

    <div class="join-details">
      <div class="join-detail">
        <p class="join-detail-label">When</p>
        <div class="join-when">
          <p class="join-detail-value">
            {next.longDate}<br />{next.time}
          </p>
          <Button href={next.calendarUrl} variant="small" target="_blank" rel="noopener noreferrer"
            >Add to calendar</Button
          >
        </div>
      </div>
      <div class="join-cart-cell">
        <Image
          src={cart}
          alt=""
          class="join-cart"
          aria-hidden="true"
          widths={[240, 480]}
          sizes="240px"
          format="webp"
          layout="none"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="join-detail join-where">
        <p class="join-detail-label">Where</p>
        <p class="join-detail-value">
          <a href={next.mapsUrl} target="_blank" rel="noopener noreferrer">{next.corner}</a><br />
          Prospect Lefferts Gardens<br />Brooklyn, New York
        </p>
      </div>
      <div class="join-map-cell">
        <iframe
          src={next.mapsEmbedUrl}
          class="join-map"
          title={`Map: ${next.corner}, Brooklyn, NY`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <div class="join-detail join-questions">
        <p class="join-detail-label">Questions</p>
        <p class="join-detail-value">
          Can't find your team? Let us know you're waiting on <a
            href="https://discord.com/invite/H9her7r8N2">Discord</a
          > by sending a message in the #general channel. For all other inquiries, see the <a
            href="/faq">FAQ</a
          >.
        </p>
      </div>
    </div>
  </div>
  {
    !isPastEvent && (
      <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(eventSchema)}
      />
    )
  }
</Base>

<script>
  import "../lib/countdown.client.ts";
</script>

<style>
  /* /join page details grid. */
  .join-page {
    position: relative;
    /* The content-page column — see .prose in src/components/Prose.astro. */
    --site-w: var(--content-w);
    width: var(--site-w);
    margin-inline: auto;
    padding-top: var(--space-section);
    padding-bottom: var(--space-block);
  }

  .join-cart-cell {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .join-cart {
    display: block;
    width: clamp(100px, 18vw, 240px);
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  .join-map {
    display: block;
    width: 100%;
    aspect-ratio: 1.618;
    border: 0;
    filter: invert(100%) hue-rotate(180deg);
  }

  .join-page h1 {
    margin-bottom: 1.25rem;
  }

  .join-countdown {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .join-sub {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text);
    margin-bottom: var(--space-gap);
  }

  .join-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: var(--space-gap);
  }

  @media (max-width: 540px) {
    .join-where {
      grid-column: 1 / -1;
    }
    .join-map-cell {
      grid-column: 1 / -1;
    }
    .join-questions {
      grid-column: 1 / -1;
    }
  }

  .join-detail-label {
    font-size: var(--fs-lg);
    font-weight: 400;
    letter-spacing: 0em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .join-detail-value {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    line-height: 1.45;
  }

  /* The date, the time, and the button that saves them, in one column as wide as
     its widest line — which is the date, unless the button's label is longer.
     A grid, so the button fills that column instead of hugging its label: the
     button ends up exactly as wide as "Saturday, August 29, 2026". Capped at the
     cell so a narrow screen wraps the date rather than overflowing. */
  .join-when {
    display: grid;
    gap: 0.9rem;
    width: max-content;
    max-width: 100%;
  }

  .join-reassurance {
    font-size: var(--fs-base);
    font-weight: 400;
    color: var(--text);
    opacity: 0.6;
  }

  .join-service-hours {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text);
  }
</style>
