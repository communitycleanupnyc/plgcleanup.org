---
// /schedule — the dates. Everything on this page comes from the "Schedule" form
// in Pages CMS (src/data/schedule.json → src/data/schedule.ts): editors add the
// month's cleanups there, and this page lists the next few of them. Past dates
// drop off on their own, so nobody edits this file to keep it current.
//
// The page is its own route, not a Markdown file in src/content/pages/, because
// it renders data. Its copy lives here, the way /join's does.
import Base from "../layouts/Base.astro";
import { UPCOMING_CLEANUPS } from "../data/schedule";

// How many cleanups the page lists. The rest stay in the form — an editor can
// add dates months ahead without making this page a wall of text.
const HOW_MANY = 4;
const cleanups = UPCOMING_CLEANUPS.slice(0, HOW_MANY);
---

<Base
  title="Schedule"
  description="The dates, times, and street corners of our next volunteer cleanups in Prospect Lefferts Gardens, Brooklyn."
  navMode="static"
>
  <div class="schedule-page">
    <h1>Upcoming cleanups</h1>
    <p class="schedule-intro">
      We clean every weekend in Prospect Lefferts Gardens, and we pick a new route each time so the
      whole neighborhood gets a turn. A cleanup takes about an hour. Nobody registers — find the
      corner, show up, and we hand you a grabber and a bag.
    </p>

    {
      cleanups.length > 0 ? (
        <ol class="schedule-list">
          {cleanups.map((cleanup, i) => {
            // The first row is the cleanup /join describes, so the row itself is
            // the link there. The rest are plain text: one place to click beats
            // four, and every corner is a tap away on /join when its turn comes.
            //
            // The date and the time are two cells each, not one: the month and
            // the dash get columns of their own, which is what lines every row's
            // months and dashes up. Splitting the date is also what drops the
            // comma that used to sit between "Saturday" and "August 29".
            const Row = i === 0 ? "a" : "div";
            return (
              <li class="schedule-item">
                <Row class="schedule-row" href={i === 0 ? "/join" : undefined}>
                  <span class="schedule-weekday">{cleanup.weekday}</span>
                  <span class="schedule-monthday">{cleanup.monthDay}</span>
                  <span class="schedule-time">
                    <span class="schedule-from">{cleanup.timeFrom}</span>
                    <span class="schedule-dash">–</span>
                    <span class="schedule-to">{cleanup.timeTo}</span>
                  </span>
                  <span class="schedule-corner">
                    {cleanup.corner}
                    {i === 0 && <span class="schedule-tag">Next</span>}
                  </span>
                </Row>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="schedule-empty">
          We're picking the next dates now. The{" "}
          <a href="https://communitycleanupplg.substack.com/subscribe">newsletter</a> and{" "}
          <a href="https://www.instagram.com/communitycleanupplg">Instagram</a> get them first.
        </p>
      )
    }

    <h2>Further out</h2>
    <p>Pick whichever of these you'll actually read:</p>
    <ul>
      <li>
        <a href="https://communitycleanupplg.substack.com/subscribe">Our newsletter</a> — the schedule
        by email, including any weather cancellations.
      </li>
      <li>
        <a href="https://www.instagram.com/communitycleanupplg">Instagram</a> — the route for the weekend,
        plus photos from the last one.
      </li>
      <li>
        <a href="https://discord.com/invite/H9her7r8N2">Discord</a> — the #general channel, where the
        schedule gets posted and where you can ask if you're not sure you're in the right place.
      </li>
    </ul>

    <h2>Trashy hours</h2>
    <p>
      Once in a while we skip the sidewalk and meet at a local business we <a href="/partners"
        >partner</a
      > with instead. Those get announced in the newsletter and on Instagram like any other cleanup.
    </p>
  </div>
</Base>

<style>
  /* /schedule — the date list and the copy around it. */
  .schedule-page {
    /* The narrower column every page but the home page runs in; --site-ml in
       tokens.css is written in terms of --site-w, so the offset follows. */
    --site-w: var(--content-w);
    width: var(--site-w);
    margin-left: var(--site-ml);
    padding-top: var(--space-section);
    padding-bottom: var(--space-block);
  }

  .schedule-page h1 {
    margin-bottom: 1.25rem;
  }

  .schedule-page h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.75rem;
  }

  .schedule-page p {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .schedule-page ul {
    margin: 0 0 1.25rem 1.25rem;
    line-height: 1.6;
  }

  .schedule-page li {
    margin-bottom: 0.375rem;
  }

  /* The dates: four columns — weekday, month and day, time, corner — collapsing
     under 560px. The LIST owns the columns and the rows inherit them with
     `subgrid`, which is the whole point: a grid per row would size each row's
     columns to its own text, and "Saturday" and "Sunday" would start their
     months in different places. Where subgrid is missing, a row stacks its cells
     the way the narrow layout does — long, not broken. */
  .schedule-list {
    display: grid;
    /* Six tracks, four columns: the time's start, dash, and end each get one,
       which is what lines the dashes up — the dash track is one glyph wide and
       shared by every row, and the start beside it is right-aligned. The gap is
       zero so a range reads tight; the space between the visible columns is
       padding on the cells that end them. */
    grid-template-columns: auto auto max-content max-content max-content 1fr;
    column-gap: 0;
    list-style: none;
    margin: var(--space-gap) 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .schedule-item,
  .schedule-row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  /* The time spans the three middle tracks and hands them straight to its own
     three cells. It stays a grid at every width, which is also why the range
     reads "10–11 am" with its three tags on separate lines: whitespace between
     grid items is never rendered. */
  .schedule-time {
    display: grid;
    grid-column: span 3;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .schedule-item {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .schedule-row {
    row-gap: 0.25rem;
    align-items: baseline;
    padding: 0.9rem 0;
  }

  /* Too narrow for columns: the row stops being a grid and its three parts take
     a line each. The time keeps a little grid of its own so its own three cells
     stay side by side instead of stacking three deep. */
  @media (max-width: 560px) {
    .schedule-item,
    .schedule-row {
      display: block;
    }
    /* No shared tracks left to line up against, so the time sizes its own. */
    .schedule-time {
      grid-column: auto;
      grid-template-columns: repeat(3, max-content);
      justify-content: start;
    }
    /* The weekday and the month are words in a line again, so the spacing that
       held their columns apart would read as a hole. */
    .schedule-weekday,
    .schedule-monthday,
    .schedule-to {
      padding-right: 0;
    }
  }

  .schedule-weekday,
  .schedule-monthday,
  .schedule-time,
  .schedule-corner {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    line-height: 1.45;
  }

  /* The space between the visible columns, since the grid's own gap has to stay
     at zero for the time to read as one range. The weekday's is smaller: it and
     the month are two columns but one date, and should read as one. */
  .schedule-monthday,
  .schedule-to {
    padding-right: clamp(1rem, 3vw, 2.5rem);
  }

  .schedule-weekday {
    padding-right: 0.6em;
  }

  /* The corner shares its cell with the "Next" tag. That cell sits in the row's
     one flexible track, so marking a row costs the fixed columns nothing. */
  .schedule-corner {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .schedule-from {
    justify-self: end;
  }

  /* "Next" — the one cleanup /join is about. */
  .schedule-tag {
    font-size: var(--fs-sm);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* That row is the link to /join. It takes the site's own link hover — accent
     fill, background-coloured text — laid over the whole row instead of a word
     inside it, so what you can click is the whole thing. No inline padding on
     purpose: this row is a subgrid, and padding would pull its columns in from
     the ones every other row lines up with. */
  a.schedule-row {
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  a.schedule-row:hover,
  a.schedule-row:focus-visible {
    background-color: var(--accent);
    color: var(--bg);
    outline: none;
  }

  /* The tag is dim against the page and would be unreadable on the fill. */
  a.schedule-row:hover .schedule-tag,
  a.schedule-row:focus-visible .schedule-tag {
    color: inherit;
  }
</style>
