---
// /schedule — the dates. Everything on this page comes from the "Schedule" form
// in Pages CMS (src/data/schedule.json → src/data/schedule.ts): editors add the
// month's cleanups there, and this page lists the next few of them. Past dates
// drop off on their own, so nobody edits this file to keep it current.
//
// The page is its own route, not a Markdown file in src/content/pages/, because
// it renders data. Its copy lives here, the way /join's does.
import Base from "../layouts/Base.astro";
import { UPCOMING_CLEANUPS, type Cleanup } from "../data/schedule";
import { SITE } from "../site.config";

// How many cleanups the page lists. The rest stay in the form — an editor can
// add dates months ahead without making this page a wall of text.
const HOW_MANY = 4;
const cleanups = UPCOMING_CLEANUPS.slice(0, HOW_MANY);

// The two links a calendar entry carries, built from the canonical origin in
// astro.config.mjs rather than typed here — an entry someone saves today outlives
// any number of edits to this page.
const joinUrl = new URL("/join", Astro.site).href;
const scheduleUrl = new URL("/schedule", Astro.site).href;

/**
 * Google's "add to calendar" template link: one URL that opens a prefilled new
 * event in whichever Google account the reader is already signed into, with
 * nothing to install and no file to download.
 *
 * https://calendar.google.com/calendar/render?action=TEMPLATE&text=…&dates=…
 * `dates` wants a compact UTC pair, "20260912T140000Z/20260912T150000Z" — the
 * ISO stamps schedule.ts already derives, with their punctuation dropped.
 */
function calendarUrl(cleanup: Cleanup) {
  const stamp = (iso: string) => iso.replace(/[-:]|\.\d{3}/g, "");
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: SITE.name,
    dates: `${stamp(cleanup.iso)}/${stamp(cleanup.endIso)}`,
    location: `${cleanup.corner}, Brooklyn, NY`,
    details: [
      `${cleanup.weekday} ${cleanup.monthDay}, ${cleanup.time} — ${cleanup.corner}.`,
      "",
      `Upcoming cleanup link: ${joinUrl}`,
      `Cleanup schedule: ${scheduleUrl}`,
    ].join("\n"),
  });
  return `https://calendar.google.com/calendar/render?${params}`;
}
---

<Base
  title="Schedule"
  description="The dates, times, and street corners of our next volunteer cleanups in Prospect Lefferts Gardens, Brooklyn."
  navMode="static"
>
  <div class="schedule-page">
    <h1>Upcoming cleanups</h1>
    <p class="schedule-intro">
      We clean every weekend in Prospect Lefferts Gardens, and we pick a new route each time so the
      whole neighborhood gets a turn. A cleanup takes about an hour. Nobody registers — find the
      corner, show up, and we hand you a grabber and a bag.
    </p>

    {
      cleanups.length > 0 ? (
        <ol class="schedule-list">
          {cleanups.map((cleanup, i) => {
            // The first row is the cleanup /join describes, so its button goes
            // there; the rest offer the date itself, as a calendar entry.
            //
            // The date and the time are two cells each, not one: the month and
            // the dash get columns of their own, which is what lines every row's
            // months and dashes up. Splitting the date is also what drops the
            // comma that would otherwise sit between "Saturday" and "August 29".
            return (
              <li class="schedule-item">
                <div class="schedule-row">
                  <span class="schedule-weekday">{cleanup.weekday}</span>
                  <span class="schedule-monthday">{cleanup.monthDay}</span>
                  <span class="schedule-time">
                    <span class="schedule-from">{cleanup.timeFrom}</span>
                    <span class="schedule-dash">–</span>
                    <span class="schedule-to">{cleanup.timeTo}</span>
                  </span>
                  <span class="schedule-corner">{cleanup.corner}</span>
                  {i === 0 ? (
                    <a class="schedule-btn" href="/join">
                      Join
                    </a>
                  ) : (
                    <a
                      class="schedule-btn"
                      href={calendarUrl(cleanup)}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Add the ${cleanup.weekday} ${cleanup.monthDay} cleanup to your calendar`}
                    >
                      Add to calendar
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="schedule-empty">
          We're picking the next dates now. The{" "}
          <a href="https://communitycleanupplg.substack.com/subscribe">newsletter</a> and{" "}
          <a href="https://www.instagram.com/communitycleanupplg">Instagram</a> get them first.
        </p>
      )
    }

    <h2>Further out</h2>
    <p>Pick whichever of these you'll actually read:</p>
    <ul>
      <li>
        <a href="https://communitycleanupplg.substack.com/subscribe">Our newsletter</a> — the schedule
        by email, including any weather cancellations.
      </li>
      <li>
        <a href="https://www.instagram.com/communitycleanupplg">Instagram</a> — the route for the weekend,
        plus photos from the last one.
      </li>
      <li>
        <a href="https://discord.com/invite/H9her7r8N2">Discord</a> — the #general channel, where the
        schedule gets posted and where you can ask if you're not sure you're in the right place.
      </li>
    </ul>

    <h2>Trashy hours</h2>
    <p>
      Once in a while we skip the sidewalk and meet at a local business we <a href="/partners"
        >partner</a
      > with instead. Those get announced in the newsletter and on Instagram like any other cleanup.
    </p>
  </div>
</Base>

<style>
  /* /schedule — the date list and the copy around it. */
  .schedule-page {
    /* The narrower column every page but the home page runs in; --site-ml in
       tokens.css is written in terms of --site-w, so the offset follows. */
    --site-w: var(--content-w);
    width: var(--site-w);
    margin-left: var(--site-ml);
    padding-top: var(--space-section);
    padding-bottom: var(--space-block);
  }

  .schedule-page h1 {
    margin-bottom: 1.25rem;
  }

  .schedule-page h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.75rem;
  }

  .schedule-page p {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .schedule-page ul {
    margin: 0 0 1.25rem 1.25rem;
    line-height: 1.6;
  }

  .schedule-page li {
    margin-bottom: 0.375rem;
  }

  /* The dates: four columns — weekday, month and day, time, corner — collapsing
     under 560px. The LIST owns the columns and the rows inherit them with
     `subgrid`, which is the whole point: a grid per row would size each row's
     columns to its own text, and "Saturday" and "Sunday" would start their
     months in different places. Where subgrid is missing, a row stacks its cells
     the way the narrow layout does — long, not broken. */
  .schedule-list {
    display: grid;
    /* Seven tracks, five columns: the time's start, dash, and end each get one,
       which is what lines the dashes up — the dash track is one glyph wide and
       shared by every row, and the start beside it is right-aligned. The gap is
       zero so a range reads tight; the space between the visible columns is one
       padding value on the cells that end them, so they sit the same distance
       apart. The last track holds the buttons, which come out the same width as
       each other because they share it. */
    grid-template-columns: auto auto max-content max-content max-content 1fr auto;
    column-gap: 0;
    list-style: none;
    margin: var(--space-gap) 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .schedule-item,
  .schedule-row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  /* The time spans the three middle tracks and hands them straight to its own
     three cells. It stays a grid at every width, which is also why the range
     reads "10–11 am" with its three tags on separate lines: whitespace between
     grid items is never rendered. */
  .schedule-time {
    display: grid;
    grid-column: span 3;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .schedule-item {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .schedule-row {
    row-gap: 0.25rem;
    align-items: baseline;
    padding: 0.9rem 0;
  }

  /* Too narrow for columns: the row stops being a grid and its three parts take
     a line each. The time keeps a little grid of its own so its own three cells
     stay side by side instead of stacking three deep. */
  @media (max-width: 560px) {
    .schedule-item,
    .schedule-row {
      display: block;
    }
    .schedule-corner {
      display: block;
    }
    /* The weekday and the month are words in a line again, so the spacing that
       held their columns apart would read as a hole. */
    .schedule-weekday,
    .schedule-monthday,
    .schedule-to,
    .schedule-corner {
      padding-right: 0;
    }
    /* On its own line under the row, at its own width rather than the phone's. */
    .schedule-btn {
      width: max-content;
      margin-top: 0.6rem;
    }
    /* No shared tracks left to line up against, so the time sizes its own. */
    .schedule-time {
      grid-column: auto;
      grid-template-columns: repeat(3, max-content);
      justify-content: start;
    }
  }

  /* Set once on the row so every column is the same size — a cell that words
     its own type is how a column ends up looking off. */
  .schedule-row {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    line-height: 1.45;
  }

  /* The space between the visible columns, since the grid's own gap has to stay
     at zero for the time to read as one range. One value for all three, so the
     weekday, the month, the time, and the corner are equally far apart. */
  .schedule-weekday,
  .schedule-monthday,
  .schedule-to,
  .schedule-corner {
    padding-right: clamp(1rem, 3vw, 2.5rem);
  }

  .schedule-from {
    justify-self: end;
  }

  /* The row's own button — the same one the nav and the home page use: the body
     face, uppercase, square, light on dark, accent on hover. Scaled down to sit
     inside a row rather than span a column. Stretched, not shrink-wrapped, so
     every row's button is the width of the widest. */
  .schedule-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: var(--fs-base);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bg);
    background: var(--btn-light);
    text-decoration: none;
    padding: 0.55rem 0.9rem;
    border-radius: var(--hover-radius);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .schedule-btn:hover,
  .schedule-btn:focus-visible {
    background: var(--accent);
    outline: none;
  }
</style>
