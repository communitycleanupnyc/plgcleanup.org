#!/bin/sh
# Mirror CI before pushing so `main` never goes red: formatting, types, build,
# and the SEO/launch gate (asset existence, canonical/sitemap drift, 404,
# placeholder links, stale Event schema, shipped TODOs…).
# Runs only on push (not every commit), so the extra seconds are infrequent.
# Bypass once with: git push --no-verify
# SEO_SKIP_FRESH mirrors the workflow env (site-checks.yml): pre-launch it
# downgrades the stale-Event check to a warning so a past event.json date can't
# block pushes. Drop it here and in the workflow at launch to re-arm the gate.
SEO_SKIP_FRESH=1 npm run format:check && npm run check && npm run build && SEO_SKIP_FRESH=1 npm run audit
