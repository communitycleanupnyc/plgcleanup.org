#!/bin/sh
# Mirror CI before pushing so `main` never goes red: formatting, types, colour
# contrast, build, and the SEO/launch gate (asset existence, canonical/sitemap
# drift, 404, placeholder links, stale Event schema, shipped TODOs, and the
# structural accessibility checks).
# Runs only on push (not every commit), so the extra seconds are infrequent.
# Bypass once with: git push --no-verify
# SEO_SKIP_PLACEHOLDER mirrors the workflow env (ci.yml): it downgrades the
# placeholder-copy check to a warning, and exists now for exactly one file —
# src/content/gallery/kevin.md, whose pull quote and body are still "...".
# Write that quote or delete the file, then drop this variable here AND in
# ci.yml / site-checks.yml to finish arming the gate (LAUNCH.md step A.4).
npm run format:check &&
	npm run check &&
	npm run a11y &&
	npm run build &&
	SEO_SKIP_PLACEHOLDER=1 npm run audit
